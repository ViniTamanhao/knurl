{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knurl.dev/schemas/manifest.schema.json",
  "title": "knurl Tool Manifest",
  "description": "Typed manifest contract for a capability-scoped knurl JavaScript tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "description",
    "read_only",
    "input_schema",
    "output_schema",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1",
      "description": "Manifest schema version."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Kebab-case tool identifier."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing positive integer tool version."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Concise summary shown in discovery and inspection output."
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      },
      "description": "Optional lowercase discovery tags."
    },
    "read_only": {
      "type": "boolean",
      "description": "Whether the tool performs no external or workspace mutations."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000,
      "description": "Optional execution timeout override in milliseconds (default 30000)."
    },
    "input_schema": {
      "$ref": "#/$defs/ioSchema",
      "description": "JSON Schema Draft 2020-12 object schema validating tool input."
    },
    "output_schema": {
      "$ref": "#/$defs/ioSchema",
      "description": "JSON Schema Draft 2020-12 object schema validating tool output."
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities",
      "description": "Explicit capability declarations enforced by the Go host."
    },
    "secrets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/secretRef"
      },
      "description": "Host-injected secrets referenced by name in exec templates or HTTP rules."
    }
  },
  "$defs": {
    "ioSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        }
      },
      "additionalProperties": true
    },
    "secretName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "description"],
      "properties": {
        "name": {
          "$ref": "#/$defs/secretName"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "$ref": "#/$defs/fsCapability"
        },
        "git": {
          "$ref": "#/$defs/gitCapability"
        },
        "http": {
          "$ref": "#/$defs/httpCapability"
        },
        "exec": {
          "$ref": "#/$defs/execCapability"
        }
      }
    },
    "fsCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read"],
      "properties": {
        "read": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^/]"
          }
        }
      }
    },
    "gitCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read"],
      "properties": {
        "read": {
          "type": "boolean"
        }
      }
    },
    "httpCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/httpRule"
          }
        }
      }
    },
    "httpRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "methods"],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["GET", "POST"]
          }
        },
        "path_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/.*$"
          }
        },
        "secrets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secretName"
          }
        },
        "allow_http": {
          "type": "boolean"
        }
      }
    },
    "execCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templates"],
      "properties": {
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/execTemplate"
          }
        }
      }
    },
    "execTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "args", "read_only", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "not": {
            "enum": [
              "sh",
              "bash",
              "zsh",
              "dash",
              "fish",
              "ksh",
              "csh",
              "tcsh",
              "cmd",
              "cmd.exe",
              "powershell",
              "powershell.exe",
              "pwsh",
              "eval"
            ]
          }
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^([^$]|\\$[^{])+$"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "args_schema": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/execArgSchema"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "read_only": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        }
      }
    },
    "execArgSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
