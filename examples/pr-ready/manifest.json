{
  "schema_version": "1",
  "name": "pr-ready",
  "version": 1,
  "description": "Check repository PR readiness using project configuration, Git status and optional mise checks",
  "tags": ["git", "pr", "checks"],
  "read_only": false,
  "timeout_ms": 120000,
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "run_checks": {"type": "boolean", "default": false},
      "allow_dirty": {"type": "boolean", "default": false}
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ready", "branch", "clean", "checks_run", "check_exit_code"],
    "properties": {
      "ready": {"type": "boolean"},
      "branch": {"type": "string"},
      "clean": {"type": "boolean"},
      "checks_run": {"type": "boolean"},
      "check_exit_code": {"type": "integer"}
    }
  },
  "capabilities": {
    "fs": {"read": [".pr-ready.json"]},
    "git": {"read": true},
    "exec": {"templates": [{
      "id": "project-check",
      "program": "mise",
      "args": ["run", "check"],
      "read_only": false,
      "description": "Run the repository check task, which may write build artifacts"
    }]}
  }
}
